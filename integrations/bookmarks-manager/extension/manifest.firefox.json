{
  "manifest_version": 3,
  "name": "Bookmarks Dynamic Manager",
  "version": "1.2.0",
  "description": "Lokale Lesezeichen-Sammlung mit KI-Import-Strukturierung, Glossar, Cross-Verlinkung, dynamischen Hashtag-Gruppen und Multi-Kategorisierung. Daten bleiben im Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmarks-dynamic-manager@johi251.github.io",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmarks Dynamic Manager"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "contextMenus", "activeTab", "tabs"],
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Aktuelle Seite zu Bookmarks Dynamic Manager hinzufügen"
    }
  }
}
