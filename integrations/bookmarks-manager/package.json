{
  "name": "bookmarks-dynamic-manager",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc --noEmit && bun scripts/test-logic.ts",
    "preview": "vite preview",
    "build:ext": "tsc --noEmit && vite build -c vite.config.ext.ts && esbuild extension/background.ts --bundle --format=iife --outfile=dist-ext/background.js --log-level=error && node scripts/package-extension.mjs",
    "build:app": "tsc --noEmit && vite build",
    "build:desktop": "vite build --base=./ --outDir dist-desktop"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "linkedom": "^0.18.14",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  }
}
