{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install --frozen-lockfile && cd integrations/bookmarks-manager && bun install --frozen-lockfile",
  "buildCommand": "bun run release:web",
  "outputDirectory": "sites/aklik-deployer-online/dist",
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}
  ]
}
