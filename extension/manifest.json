{
  "manifest_version": 3,
  "name": "aKlik-Deployer",
  "version": "1.1.0",
  "description": "Repository-Startwege über deine lokale aKlik-Deployer-App prüfen.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:43110/*"
  ],
  "action": {
    "default_title": "Mit aKlik-Deployer prüfen",
    "default_popup": "popup.html",
    "default_icon": {
      "192": "icon-192.png"
    }
  },
  "icons": {
    "192": "icon-192.png"
  }
}
